import re
from pathlib import Path
a=Path('/home/ma-user/work/s9/experiments/squaresum_s02bs_cloud_20260806_1324/strided_s02bs.log')
b=Path('/home/ma-user/work/s9/experiments/squaresum_s02bt4_cloud_20260806_1416/strided_s02bt4_repeat.log')
pat=re.compile(r'RESULT .*case=(\S+) dtype=(\S+).*median_us=([0-9.]+)')
def load(p): return {(m.group(1),m.group(2)):float(m.group(3)) for m in map(pat.search,p.read_text().splitlines()) if m}
x,y=load(a),load(b)
changed=('inner1','inner2','inner4','inner8','inner16')
for c in changed:
 av=sum(v for (k,d),v in x.items() if k==c); bv=sum(v for (k,d),v in y.items() if k==c)
 print(c, f'{av:.6f}', f'{bv:.6f}', f'{av/bv:.6f}x')
ks=[k for k in x if k[0] in changed]
print('TARGET15',f'{sum(x[k] for k in ks):.6f}',f'{sum(y[k] for k in ks):.6f}',f'{sum(x[k] for k in ks)/sum(y[k] for k in ks):.6f}x')
print('ALL33',f'{sum(x.values()):.6f}',f'{sum(y.values()):.6f}',f'{sum(x.values())/sum(y.values()):.6f}x')
reg=[(y[k]/x[k],k,x[k],y[k]) for k in x if y[k]>x[k]*1.10]
print('REG_GT10',len(reg))
for r,k,av,bv in sorted(reg,reverse=True): print(k,f'{av:.3f}->{bv:.3f}',f'{r:.3f}x')
